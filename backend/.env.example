# ==============================================================================
# MarineAI & Aqua Intellect Environment Configuration
# Copy this file to '.env' and add your real API keys as needed.
# All VITE_* keys are automatically loaded into the React Frontend (Vite).
# All backend keys are used by the FastAPI Python multi-agent backend.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND SERVER & BACKEND API URLS
# ------------------------------------------------------------------------------
# Port for Vite development server (default: 5188)
VITE_PORT=5188

# Base URL pointing to the FastAPI Python agent orchestration backend
VITE_BACKEND_URL=http://localhost:8000
VITE_AGENT_QUERY_ENDPOINT=http://localhost:8000/api/agent/query

# ------------------------------------------------------------------------------
# 2. GEOSPATIAL & MAP TILE SERVICES (OPTIONAL)
# By default, MarineAI uses free, high-resolution ESRI World Imagery,
# ESRI Ocean Topography, and OpenStreetMap which require NO API keys.
# If you wish to use CARTO or Mapbox customized styles, supply keys below:
# ------------------------------------------------------------------------------
# Carto Basemaps API Key (removes "add your api keys" watermark on CARTO tiles)
VITE_CARTO_API_KEY=

# Mapbox Access Token (if using Mapbox GL or custom vector styles)
# Get from: https://account.mapbox.com/
VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjbGV4YW1wbGUifQ.example

# Google Maps Platform API Key (if enabling Google Ocean / Satellite overlay)
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 3. METEOROLOGICAL & OCEANOGRAPHIC DATA APIS
# ------------------------------------------------------------------------------
# Open-Meteo Marine API (Free, no API key required for non-commercial)
# Docs: https://open-meteo.com/en/docs/marine-weather-api
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine

# OpenWeatherMap API Key (for high-resolution coastal Doppler radar / squall warnings)
# Get from: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# Copernicus Marine Service (CMEMS) API Credentials (for global ocean currents & Chl-a)
# Register at: https://marine.copernicus.eu/
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# INCOIS Coastal Telemetry & PFZ Advisory Feed Access
INCOIS_API_BASE_URL=https://incois.gov.in/portal/
INCOIS_BULLETIN_FEED_URL=https://incois.gov.in/OOS/pfz.jsp

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & LLM AGENT PROVIDERS
# Used by Python backend agents (backend/agents/*.py) & Frontend Copilot
# ------------------------------------------------------------------------------
# Google Gemini API Key (Recommended for deep ocean reasoning & high rate limits)
# Get from: https://aistudio.google.com/
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# OpenAI API Key (used by OrchestratorAgent and AI Challenger in Python backend)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=changeme

# Anthropic Claude API Key (optional fallback agent)
ANTHROPIC_API_KEY=

# DeepSeek API Key (optional open-weights agent provider)
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# 5. VESSEL AIS TELEMETRY & COAST GUARD TRACKING (OPTIONAL)
# ------------------------------------------------------------------------------
# Spire Maritime / AISHub / MarineTraffic API Key for live vessel transponders
VITE_AIS_API_KEY=
VITE_MARINETRAFFIC_API_KEY=

# ------------------------------------------------------------------------------
# 6. EMERGENCY DISTRESS & SMS GATEWAY
# ------------------------------------------------------------------------------
# Indian Coast Guard MRCC Emergency Hotline (Toll-Free 1093)
COAST_GUARD_MRCC_HOTLINE=1093
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
